{
  cert_issuer acme {
    dns route53 {
      hosted_zone_id {$ROUTE53_HOSTED_ZONE_ID}
      wait_for_route53_sync true
    }
    propagation_delay 30s
  }
}

(access_log) {
  log {
    output file /var/log/caddy/access.log {
      roll_size 10MiB
      roll_keep 3
    }
  }
}

# Dashboard static server
{$DOMAIN}, http:// {
  import access_log
  handle /status/applications {
    reverse_proxy status-agent:8080
  }
  handle_path /status/northcom {
    reverse_proxy {$STATUS_NORTHCOM_UPSTREAM:status-agent:8080}
  }
  handle_path /status/southcom {
    reverse_proxy {$STATUS_SOUTHCOM_UPSTREAM}
  }
  handle_path /status/eastcom {
    reverse_proxy {$STATUS_EASTCOM_UPSTREAM}
  }
  handle {
    root * /usr/share/caddy
    rewrite /live-status /index.html
    file_server
  }
}

# Reusable snippet for Tailscale HTTPS upstreams.
(ts_upstream) {
  reverse_proxy https://{args[0]}.spaniel-dragon.ts.net {
    transport http {
      tls_server_name {args[0]}.spaniel-dragon.ts.net
    }
  }
}

# Example for an entry that has a *public A record* DNS entry
# The a record should point to the parent IP (in this case, centcom)
# Use DNS challenge so cert issuance works even when hostnames resolve only to a Tailscale IP
#
# sub = the Tailscale name of the machine
#
# sub.{$DOMAIN} {
#   import ts_upstream sub
# }

# Subdomains
ai.{$DOMAIN} {
  import access_log
  import ts_upstream ai
}
beszel.{$DOMAIN} {
  import access_log
  reverse_proxy {$BESZEL_UPSTREAM}
}
draw.{$DOMAIN} {
  import access_log
  reverse_proxy {$DRAW_UPSTREAM}
}
go.{$DOMAIN} {
  import access_log
  import ts_upstream go
}
gym.{$DOMAIN} {
  import access_log
  reverse_proxy {$GYM_UPSTREAM}
}
gym-mcp.{$DOMAIN} {
  import access_log
  handle /mcp {
    reverse_proxy {$GYM_MCP_UPSTREAM}
  }
  handle {
    respond "Not found" 404
  }
}
ha.{$DOMAIN} {
  import access_log
  import ts_upstream home-assistant
}
pihole.{$DOMAIN} {
  import access_log
  reverse_proxy {$PIHOLE_UPSTREAM:pihole:80}
}
rss.{$DOMAIN} {
  import access_log
  reverse_proxy {$RSS_UPSTREAM}
}
