TAILSCALE_IP=
# Shared multi-host configuration (leave TAILSCALE_IP for single-host use).
TAILSCALE_IP_NORTHCOM=
TAILSCALE_IP_SOUTHCOM=
TAILSCALE_IP_EASTCOM=
TAILSCALE_IP_WESTCOM=

# Pi-hole administrator passwords used for northcom-to-eastcom synchronization.
PIHOLE_NORTHCOM_PASSWORD=
PIHOLE_EASTCOM_PASSWORD=

GO_LINK_TS_AUTHKEY=

# make new-host: optional reusable, tagged (tag:centcom) auth key so Tailscale
# enrolls without a browser login, and the LAN subnet each Pi advertises.
TS_AUTHKEY=
LAN_SUBNET=192.168.4.0/22

DOMAIN=vpn.example.com
ROUTE53_HOSTED_ZONE_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

BACKUP_S3_BUCKET=

BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=

# Optional openGym MCP over HTTPS at https://gym.${DOMAIN}/mcp. Both lines are needed:
# the profile starts the container, MCP=on enables it in the app. Leave blank to disable.
COMPOSE_PROFILES=
MCP=

# Tailscale policy updates (make policy-apply). Run from your workstation, not the Pis.
# Preferred: an OAuth client with only the policy_file scope. TS_API_KEY also works.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
# TS_API_KEY=
# TS_TAILNET=-

# Karakeep (southcom)
KARAKEEP_NEXTAUTH_SECRET=
KARAKEEP_MEILI_MASTER_KEY=
KARAKEEP_DISABLE_SIGNUPS=false

# Vaultwarden (southcom; temporarily set true only to create the first account)
VAULTWARDEN_SIGNUPS_ALLOWED=false

# DNS failover (make install-dns-failover, run on southcom). OAuth client needs the
# `dns` scope (Read + Write). Alerts go out over SMTP; use the same
# settings as the Beszel hub (Settings > Notifications > SMTP). Port 587 = STARTTLS, 465 = TLS.
DNS_FAILOVER_HOST=southcom
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
TS_DNS_OAUTH_CLIENT_ID=
TS_DNS_OAUTH_CLIENT_SECRET=
DNS_ALERT_FROM=
DNS_ALERT_TO=
